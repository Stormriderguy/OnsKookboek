# Kopieer naar /etc/kookboek-scanner/scanner.env en vul in.

# Supabase: Project Settings → API (of de knop "Connect").
# Gebruik de publieke publishable/anon key, NIET de secret/service_role key.
SUPABASE_URL=https://tawzjhnropjocehnkopx.supabase.co
SUPABASE_KEY=

# Het beeldmodel in Ollama. Begin met de 3b; de 7b is beter maar trager.
OLLAMA_MODEL=qwen2.5vl:3b

# Alleen de app op deze adressen mag de scanner gebruiken.
ALLOWED_ORIGINS=https://onskookboek.vercel.app,http://localhost:5173

# Scans per persoon per dag, en hoeveel scans er tegelijk mogen wachten.
DAILY_LIMIT=30
MAX_QUEUE=10

# Hoe lang één scan mag duren voordat hij wordt afgebroken (minuten).
SCAN_TIMEOUT_MIN=10

PORT=8787
