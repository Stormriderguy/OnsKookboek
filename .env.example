# Kopieer dit bestand naar .env en vul de waarden in.
# Te vinden in Supabase: Project Settings → API (of de knop "Connect").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Het scannen loopt via de Vercel-functie api/scan.ts. Die gebruikt ANTHROPIC_API_KEY,
# die alleen in Vercel staat (niet hier, en nooit met VITE_ ervoor).
# Optioneel, ook alleen in Vercel: PIXABAY_API_KEY (of PEXELS_API_KEY) als reserve voor een passende foto;
# eerst wordt Openverse geprobeerd, dat geen sleutel nodig heeft.
